<form class="hide-ui-form" autocomplete="off">
   <div class="hide-ui-hint">
      <i class="fas fa-eye-slash"></i>
      <span>Check the items you want to <strong>hide</strong> from your own screen. Unchecked items will remain visible.</span>
   </div>
   <div class="hide-ui-options">

      {{!-- ── Navigation ─────────────────────────────────────────── --}}
      {{#if showNavigationSection}}
      <section class="hide-ui-section">
         <h3 class="hide-ui-section-header">
            <i class="fas fa-map"></i> Navigation
         </h3>
         {{#if canControl.hideNavigation.navToggle}}
         <div class="hide-ui-option">
            <label for="hideNavigation-navToggle">Navigation Toggle</label>
            <label class="hide-ui-switch">
               <input type="checkbox" id="hideNavigation-navToggle" name="hideNavigation.navToggle"
               {{checked playerConfig.hideNavigation.navToggle}} />
               <div class="hide-ui-switch-track"></div>
            </label>
         </div>
         {{/if}}
         {{#if canControl.hideNavigation.sceneList}}
         <div class="hide-ui-option">
            <label for="hideNavigation-sceneList">Scene List</label>
            <label class="hide-ui-switch">
               <input type="checkbox" id="hideNavigation-sceneList" name="hideNavigation.sceneList"
               {{checked playerConfig.hideNavigation.sceneList}} />
               <div class="hide-ui-switch-track"></div>
            </label>
         </div>
         {{/if}}
         {{#if renderBossBarOption}}
         {{#if canControl.hideNavigation.bossBar}}
         <div class="hide-ui-option">
            <label for="hideNavigation-bossBar">Boss Bar</label>
            <label class="hide-ui-switch">
               <input type="checkbox" id="hideNavigation-bossBar" name="hideNavigation.bossBar"
               {{checked playerConfig.hideNavigation.bossBar}} />
               <div class="hide-ui-switch-track"></div>
            </label>
         </div>
         {{/if}}
         {{/if}}
      </section>
      {{/if}}

      {{!-- ── Controls ─────────────────────────────────────────────── --}}
      {{#if canControl.hideControls}}
      <div class="hide-ui-option hide-ui-option--standalone">
         <label for="hideControls">
            <i class="fas fa-tools" style="margin-right:0.3rem;opacity:0.6"></i>
            Controls Panel
         </label>
         <label class="hide-ui-switch">
            <input type="checkbox" id="hideControls" name="hideControls"
            {{checked playerConfig.hideControls}} />
            <div class="hide-ui-switch-track"></div>
         </label>
      </div>
      {{/if}}

      {{!-- ── Sidebar ───────────────────────────────────────────────── --}}
      {{#if showSidebarSection}}
      <section class="hide-ui-section">
         <h3 class="hide-ui-section-header">
            <i class="fas fa-columns"></i> Sidebar
         </h3>
         {{#if canControl.hideSideBar.chatLog}}
         <div class="hide-ui-option">
            <label for="hideSideBar-chatLog"><i class="fa-solid fa-comments"></i> Chat Messages</label>
            <label class="hide-ui-switch">
               <input type="checkbox" id="hideSideBar-chatLog" name="hideSideBar.chatLog"
               {{checked playerConfig.hideSideBar.chatLog}} />
               <div class="hide-ui-switch-track"></div>
            </label>
         </div>
         {{/if}}
         {{#if canControl.hideSideBar.chatInput}}
         <div class="hide-ui-suboptions hide-ui-suboptions--deep">
            <div class="hide-ui-option">
               <label for="hideSideBar-chatInput">Chat Input</label>
               <label class="hide-ui-switch">
                  <input type="checkbox" id="hideSideBar-chatInput" name="hideSideBar.chatInput"
                  {{checked playerConfig.hideSideBar.chatInput}} />
                  <div class="hide-ui-switch-track"></div>
               </label>
            </div>
            {{#if canControl.hideSideBar.chatMenuBar}}
            <div class="hide-ui-option">
               <label for="hideSideBar-chatMenuBar">Chat Editor Menu Bar</label>
               <label class="hide-ui-switch">
                  <input type="checkbox" id="hideSideBar-chatMenuBar" name="hideSideBar.chatMenuBar"
                  {{checked playerConfig.hideSideBar.chatMenuBar}} />
                  <div class="hide-ui-switch-track"></div>
               </label>
            </div>
            {{/if}}
         </div>
         {{/if}}
         {{#if canControl.hideSideBar.combatTracker}}
         <div class="hide-ui-option">
            <label for="hideSideBar-combatTracker"><i class="fa-solid fa-swords"></i> Combat Encounters</label>
            <label class="hide-ui-switch">
               <input type="checkbox" id="hideSideBar-combatTracker" name="hideSideBar.combatTracker"
               {{checked playerConfig.hideSideBar.combatTracker}} />
               <div class="hide-ui-switch-track"></div>
            </label>
         </div>
         {{/if}}
         {{#if canControl.hideSideBar.scenesDirectory}}
         <div class="hide-ui-option">
            <label for="hideSideBar-scenesDirectory"><i class="fa-solid fa-map"></i> Scenes</label>
            <label class="hide-ui-switch">
               <input type="checkbox" id="hideSideBar-scenesDirectory" name="hideSideBar.scenesDirectory"
               {{checked playerConfig.hideSideBar.scenesDirectory}} />
               <div class="hide-ui-switch-track"></div>
            </label>
         </div>
         {{/if}}
         {{#if canControl.hideSideBar.placeables}}
         <div class="hide-ui-option">
            <label for="hideSideBar-placeables"><i class="fa-solid fa-puzzle-piece"></i> Placeables</label>
            <label class="hide-ui-switch">
               <input type="checkbox" id="hideSideBar-placeables" name="hideSideBar.placeables"
               {{checked playerConfig.hideSideBar.placeables}} />
               <div class="hide-ui-switch-track"></div>
            </label>
         </div>
         {{/if}}
         {{#if canControl.hideSideBar.actorsDirectory}}
         <div class="hide-ui-option">
            <label for="hideSideBar-actorsDirectory"><i class="fa-solid fa-user"></i> Actors</label>
            <label class="hide-ui-switch">
               <input type="checkbox" id="hideSideBar-actorsDirectory" name="hideSideBar.actorsDirectory"
               {{checked playerConfig.hideSideBar.actorsDirectory}} />
               <div class="hide-ui-switch-track"></div>
            </label>
         </div>
         {{/if}}
         {{#if canControl.hideSideBar.itemsDirectory}}
         <div class="hide-ui-option">
            <label for="hideSideBar-itemsDirectory"><i class="fa-solid fa-suitcase"></i> Items</label>
            <label class="hide-ui-switch">
               <input type="checkbox" id="hideSideBar-itemsDirectory" name="hideSideBar.itemsDirectory"
               {{checked playerConfig.hideSideBar.itemsDirectory}} />
               <div class="hide-ui-switch-track"></div>
            </label>
         </div>
         {{/if}}
         {{#if canControl.hideSideBar.journalEntries}}
         <div class="hide-ui-option">
            <label for="hideSideBar-journalEntries"><i class="fa-solid fa-book-open"></i> Journal</label>
            <label class="hide-ui-switch">
               <input type="checkbox" id="hideSideBar-journalEntries" name="hideSideBar.journalEntries"
               {{checked playerConfig.hideSideBar.journalEntries}} />
               <div class="hide-ui-switch-track"></div>
            </label>
         </div>
         {{/if}}
         {{#if canControl.hideSideBar.rollableTables}}
         <div class="hide-ui-option">
            <label for="hideSideBar-rollableTables"><i class="fa-solid fa-table-list"></i> Rollable Tables</label>
            <label class="hide-ui-switch">
               <input type="checkbox" id="hideSideBar-rollableTables" name="hideSideBar.rollableTables"
               {{checked playerConfig.hideSideBar.rollableTables}} />
               <div class="hide-ui-switch-track"></div>
            </label>
         </div>
         {{/if}}
         {{#if canControl.hideSideBar.cardStacks}}
         <div class="hide-ui-option">
            <label for="hideSideBar-cardStacks"><i class="fa-solid fa-cards"></i> Card Stacks</label>
            <label class="hide-ui-switch">
               <input type="checkbox" id="hideSideBar-cardStacks" name="hideSideBar.cardStacks"
               {{checked playerConfig.hideSideBar.cardStacks}} />
               <div class="hide-ui-switch-track"></div>
            </label>
         </div>
         {{/if}}
         {{#if canControl.hideSideBar.macros}}
         <div class="hide-ui-option">
            <label for="hideSideBar-macros"><i class="fa-solid fa-code"></i> Macros</label>
            <label class="hide-ui-switch">
               <input type="checkbox" id="hideSideBar-macros" name="hideSideBar.macros"
               {{checked playerConfig.hideSideBar.macros}} />
               <div class="hide-ui-switch-track"></div>
            </label>
         </div>
         {{/if}}
         {{#if canControl.hideSideBar.audioPlaylists}}
         <div class="hide-ui-option">
            <label for="hideSideBar-audioPlaylists"><i class="fa-solid fa-music"></i> Playlists</label>
            <label class="hide-ui-switch">
               <input type="checkbox" id="hideSideBar-audioPlaylists" name="hideSideBar.audioPlaylists"
               {{checked playerConfig.hideSideBar.audioPlaylists}} />
               <div class="hide-ui-switch-track"></div>
            </label>
         </div>
         {{/if}}
         {{#if canControl.hideSideBar.compendiumPacks}}
         <div class="hide-ui-option">
            <label for="hideSideBar-compendiumPacks"><i class="fa-solid fa-book-atlas"></i> Compendium Packs</label>
            <label class="hide-ui-switch">
               <input type="checkbox" id="hideSideBar-compendiumPacks" name="hideSideBar.compendiumPacks"
               {{checked playerConfig.hideSideBar.compendiumPacks}} />
               <div class="hide-ui-switch-track"></div>
            </label>
         </div>
         {{/if}}
         {{#if canControl.hideSideBar.gameSettings}}
         <div class="hide-ui-option">
            <label for="hideSideBar-gameSettings"><i class="fa-solid fa-gears"></i> Settings</label>
            <label class="hide-ui-switch">
               <input type="checkbox" id="hideSideBar-gameSettings" name="hideSideBar.gameSettings"
               {{checked playerConfig.hideSideBar.gameSettings}} />
               <div class="hide-ui-switch-track"></div>
            </label>
         </div>
         <div class="hide-ui-suboptions hide-ui-suboptions--deep">
            {{#if canControl.hideSideBar.settingsContent.gameSettings}}
            <div class="hide-ui-option">
               <label for="hideSideBar-settingsContent-gameSettings">Game Settings</label>
               <label class="hide-ui-switch">
                  <input type="checkbox" id="hideSideBar-settingsContent-gameSettings"
                  name="hideSideBar.settingsContent.gameSettings"
                  {{checked playerConfig.hideSideBar.settingsContent.gameSettings}} />
                  <div class="hide-ui-switch-track"></div>
               </label>
            </div>
            {{/if}}
            {{#if canControl.hideSideBar.settingsContent.activeModules}}
            <div class="hide-ui-option">
               <label for="hideSideBar-settingsContent-activeModules">Active Modules</label>
               <label class="hide-ui-switch">
                  <input type="checkbox" id="hideSideBar-settingsContent-activeModules"
                  name="hideSideBar.settingsContent.activeModules"
                  {{checked playerConfig.hideSideBar.settingsContent.activeModules}} />
                  <div class="hide-ui-switch-track"></div>
               </label>
            </div>
            {{/if}}
            {{#if canControl.hideSideBar.settingsContent.tours}}
            <div class="hide-ui-option">
               <label for="hideSideBar-settingsContent-tours">Tour Management</label>
               <label class="hide-ui-switch">
                  <input type="checkbox" id="hideSideBar-settingsContent-tours"
                  name="hideSideBar.settingsContent.tours"
                  {{checked playerConfig.hideSideBar.settingsContent.tours}} />
                  <div class="hide-ui-switch-track"></div>
               </label>
            </div>
            {{/if}}
            {{#if canControl.hideSideBar.settingsContent.help}}
            <div class="hide-ui-option">
               <label for="hideSideBar-settingsContent-help">Help &amp; Documentation</label>
               <label class="hide-ui-switch">
                  <input type="checkbox" id="hideSideBar-settingsContent-help"
                  name="hideSideBar.settingsContent.help"
                  {{checked playerConfig.hideSideBar.settingsContent.help}} />
                  <div class="hide-ui-switch-track"></div>
               </label>
            </div>
            {{/if}}
         </div>
         {{/if}}
         {{#if canControl.hideSideBar.diceSoNice}}
         <div class="hide-ui-option">
            <label for="hideSideBar-diceSoNice"><i class="fa-solid fa-dice-d20"></i> Dice So Nice!</label>
            <label class="hide-ui-switch">
               <input type="checkbox" id="hideSideBar-diceSoNice" name="hideSideBar.diceSoNice"
               {{checked playerConfig.hideSideBar.diceSoNice}} />
               <div class="hide-ui-switch-track"></div>
            </label>
         </div>
         {{/if}}
      </section>
      {{/if}}

      {{!-- ── Players & Interface ──────────────────────────────────── --}}
      {{#if showPlayersSection}}
      <section class="hide-ui-section">
         <h3 class="hide-ui-section-header">
            <i class="fas fa-users"></i> Players &amp; Interface
         </h3>
         {{#if canControl.hidePlayers}}
         <div class="hide-ui-option">
            <label for="hidePlayers">Active Players List</label>
            <label class="hide-ui-switch">
               <input type="checkbox" id="hidePlayers" name="hidePlayers"
               {{checked playerConfig.hidePlayers}} />
               <div class="hide-ui-switch-track"></div>
            </label>
         </div>
         {{/if}}
         {{#if canControl.hideCameraViews}}
         <div class="hide-ui-option">
            <label for="hideCameraViews">
               <i class="fa-solid fa-camera-web"></i> Camera / Audio Bar
            </label>
            <label class="hide-ui-switch">
               <input type="checkbox" id="hideCameraViews" name="hideCameraViews"
               {{checked playerConfig.hideCameraViews}} />
               <div class="hide-ui-switch-track"></div>
            </label>
         </div>
         {{/if}}
         {{#if canControl.hidePlayerConfig}}
         <div class="hide-ui-option">
            <label for="hidePlayerConfig">Player Configuration Button</label>
            <label class="hide-ui-switch">
               <input type="checkbox" id="hidePlayerConfig" name="hidePlayerConfig"
               {{checked playerConfig.hidePlayerConfig}} />
               <div class="hide-ui-switch-track"></div>
            </label>
         </div>
         {{/if}}
      </section>
      {{/if}}

      {{!-- ── Hotbar ────────────────────────────────────────────────── --}}
      {{#if showHotbarSection}}
      <section class="hide-ui-section">
         <h3 class="hide-ui-section-header">
            <i class="fas fa-th"></i> Hotbar
         </h3>
         {{#if canControl.hideHotbar}}
         <div class="hide-ui-option hide-ui-option--segmented">
            <label id="hideHotbar-label">Macro Hotbar</label>
            <div class="hide-ui-segmented hide-ui-mode" role="radiogroup" aria-labelledby="hideHotbar-label">
               <label class="hide-ui-segment">
                  <input type="radio" name="hideHotbar" value="off" {{#if hideHotbarMode.off}}checked{{/if}} />
                  <span>Off</span>
               </label>
               <label class="hide-ui-segment">
                  <input type="radio" name="hideHotbar" value="hide" {{#if hideHotbarMode.hide}}checked{{/if}} />
                  <span>Hide</span>
               </label>
               <label class="hide-ui-segment">
                  <input type="radio" name="hideHotbar" value="autohide" {{#if hideHotbarMode.autohide}}checked{{/if}} />
                  <span>Auto-hide</span>
               </label>
            </div>
         </div>
         {{/if}}
         {{#if canControl.hideHotbarControls.lock}}
         <div class="hide-ui-option">
            <label for="hideHotbarControls-lock"><i class="fa-solid fa-lock"></i> Lock Hotbar</label>
            <label class="hide-ui-switch">
               <input type="checkbox" id="hideHotbarControls-lock" name="hideHotbarControls.lock"
               {{checked playerConfig.hideHotbarControls.lock}} />
               <div class="hide-ui-switch-track"></div>
            </label>
         </div>
         {{/if}}
         {{#if canControl.hideHotbarControls.clear}}
         <div class="hide-ui-option">
            <label for="hideHotbarControls-clear"><i class="fa-solid fa-trash"></i> Clear Hotbar</label>
            <label class="hide-ui-switch">
               <input type="checkbox" id="hideHotbarControls-clear" name="hideHotbarControls.clear"
               {{checked playerConfig.hideHotbarControls.clear}} />
               <div class="hide-ui-switch-track"></div>
            </label>
         </div>
         {{/if}}
         {{#if canControl.hideHotbarControls.menu}}
         <div class="hide-ui-option">
            <label for="hideHotbarControls-menu"><i class="fa-solid fa-bars"></i> Main Menu</label>
            <label class="hide-ui-switch">
               <input type="checkbox" id="hideHotbarControls-menu" name="hideHotbarControls.menu"
               {{checked playerConfig.hideHotbarControls.menu}} />
               <div class="hide-ui-switch-track"></div>
            </label>
         </div>
         {{/if}}
         {{#if canControl.hideHotbarControls.mute}}
         <div class="hide-ui-option">
            <label for="hideHotbarControls-mute"><i class="fa-solid fa-volume"></i> Mute Volume</label>
            <label class="hide-ui-switch">
               <input type="checkbox" id="hideHotbarControls-mute" name="hideHotbarControls.mute"
               {{checked playerConfig.hideHotbarControls.mute}} />
               <div class="hide-ui-switch-track"></div>
            </label>
         </div>
         {{/if}}
      </section>
      {{/if}}

      {{!-- ── HUD ──────────────────────────────────────────────────── --}}
      {{#if showHudSection}}
      <section class="hide-ui-section">
         <h3 class="hide-ui-section-header">
            <i class="fas fa-dot-circle"></i> HUD
         </h3>
         {{#if canControl.hideTokenHUD}}
         <div class="hide-ui-option hide-ui-option--master">
            <label for="hideTokenHUD">Hide Entire Token HUD</label>
            <label class="hide-ui-switch">
               <input type="checkbox" id="hideTokenHUD" name="hideTokenHUD"
               {{checked playerConfig.hideTokenHUD}} />
               <div class="hide-ui-switch-track"></div>
            </label>
         </div>
         {{/if}}
         <div class="hide-ui-suboptions">
            {{#if canControl.hideTokenHUDControls.statusEffects}}
            <div class="hide-ui-option">
               <label for="hideTokenHUDControls-statusEffects">Assign Status Effects</label>
               <label class="hide-ui-switch">
                  <input type="checkbox" id="hideTokenHUDControls-statusEffects" name="hideTokenHUDControls.statusEffects"
                  {{checked playerConfig.hideTokenHUDControls.statusEffects}} />
                  <div class="hide-ui-switch-track"></div>
               </label>
            </div>
            {{/if}}
            {{#if canControl.hideTokenHUDControls.movementAction}}
            <div class="hide-ui-option">
               <label for="hideTokenHUDControls-movementAction">Movement Action</label>
               <label class="hide-ui-switch">
                  <input type="checkbox" id="hideTokenHUDControls-movementAction" name="hideTokenHUDControls.movementAction"
                  {{checked playerConfig.hideTokenHUDControls.movementAction}} />
                  <div class="hide-ui-switch-track"></div>
               </label>
            </div>
            {{/if}}
            {{#if canControl.hideTokenHUDControls.target}}
            <div class="hide-ui-option">
               <label for="hideTokenHUDControls-target">Target</label>
               <label class="hide-ui-switch">
                  <input type="checkbox" id="hideTokenHUDControls-target" name="hideTokenHUDControls.target"
                  {{checked playerConfig.hideTokenHUDControls.target}} />
                  <div class="hide-ui-switch-track"></div>
               </label>
            </div>
            {{/if}}
            {{#if canControl.hideTokenHUDControls.combat}}
            <div class="hide-ui-option">
               <label for="hideTokenHUDControls-combat">Enter Combat</label>
               <label class="hide-ui-switch">
                  <input type="checkbox" id="hideTokenHUDControls-combat" name="hideTokenHUDControls.combat"
                  {{checked playerConfig.hideTokenHUDControls.combat}} />
                  <div class="hide-ui-switch-track"></div>
               </label>
            </div>
            {{/if}}
            {{#if canControl.hideTokenHUDControls.hide}}
            <div class="hide-ui-option">
               <label for="hideTokenHUDControls-hide">Hide</label>
               <label class="hide-ui-switch">
                  <input type="checkbox" id="hideTokenHUDControls-hide" name="hideTokenHUDControls.hide"
                  {{checked playerConfig.hideTokenHUDControls.hide}} />
                  <div class="hide-ui-switch-track"></div>
               </label>
            </div>
            {{/if}}
            {{#if canControl.hideTokenHUDControls.lock}}
            <div class="hide-ui-option">
               <label for="hideTokenHUDControls-lock">Lock</label>
               <label class="hide-ui-switch">
                  <input type="checkbox" id="hideTokenHUDControls-lock" name="hideTokenHUDControls.lock"
                  {{checked playerConfig.hideTokenHUDControls.lock}} />
                  <div class="hide-ui-switch-track"></div>
               </label>
            </div>
            {{/if}}
            {{#if canControl.hideTokenHUDControls.config}}
            <div class="hide-ui-option">
               <label for="hideTokenHUDControls-config">Open Configuration</label>
               <label class="hide-ui-switch">
                  <input type="checkbox" id="hideTokenHUDControls-config" name="hideTokenHUDControls.config"
                  {{checked playerConfig.hideTokenHUDControls.config}} />
                  <div class="hide-ui-switch-track"></div>
               </label>
            </div>
            {{/if}}
         </div>
         {{#if renderTokenActionHudOption}}
         {{#if canControl.hideTokenActionHUD}}
         <div class="hide-ui-option">
            <label for="hideTokenActionHUD">Token Action HUD</label>
            <label class="hide-ui-switch">
               <input type="checkbox" id="hideTokenActionHUD" name="hideTokenActionHUD"
               {{checked playerConfig.hideTokenActionHUD}} />
               <div class="hide-ui-switch-track"></div>
            </label>
         </div>
         {{/if}}
         {{/if}}
      </section>
      {{/if}}

   </div>

   <footer class="hide-ui-form-footer">
      <button type="button" data-action="toggleAll">
         <i class="fas fa-check-double"></i> Toggle All
      </button>
      <button type="submit">
         <i class="fas fa-save"></i> Save Changes
      </button>
   </footer>
</form>
